{
  "domain": "apple_tv",
  "name": "Apple TV",
  "codeowners": [
    "@postlund"
  ],
  "config_flow": true,
  "dependencies": [
    "zeroconf"
  ],
  "documentation": "https://www.home-assistant.io/integrations/apple_tv",
  "integration_type": "device",
  "iot_class": "local_push",
  "loggers": [
    "pyatv",
    "srptools"
  ],
  "requirements": [
    "pyatv @ git+https://github.com/ahamill85/pyatv.git@fix-homepod-remote-artwork"
  ],
  "zeroconf": [
    "_mediaremotetv._tcp.local.",
    "_companion-link._tcp.local.",
    "_airport._tcp.local.",
    "_sleep-proxy._udp.local.",
    "_touch-able._tcp.local.",
    "_appletv-v2._tcp.local.",
    "_hscp._tcp.local.",
    {
      "properties": {
        "model": "appletv*"
      },
      "type": "_airplay._tcp.local."
    },
    {
      "properties": {
        "model": "audioaccessory*"
      },
      "type": "_airplay._tcp.local."
    },
    {
      "properties": {
        "am": "airport*"
      },
      "type": "_airplay._tcp.local."
    },
    {
      "properties": {
        "am": "appletv*"
      },
      "type": "_raop._tcp.local."
    },
    {
      "properties": {
        "am": "audioaccessory*"
      },
      "type": "_raop._tcp.local."
    },
    {
      "properties": {
        "am": "airport*"
      },
      "type": "_raop._tcp.local."
    }
  ],
  "version": "2026.10.4.1",
  "issue_tracker": "https://github.com/ahamill85/pyatv/issues"
}